@startuml logical-data-lab2
title Логическая схема данных. Электронные договоры и доп. соглашения

entity "Обучающийся\n<<внешний, 1С>>" as Student {
  * СНИЛС
  --
  ФИО
  дата рождения
  паспортные данные
  контакты
}

entity "Плательщик\n<<внешний, 1С>>" as Payer {
  * СНИЛС / ИНН
  --
  ФИО или наименование
  реквизиты
  основание представительства
}

entity "Учебный план\n<<внешний, 1С>>" as Plan {
  * код плана
  --
  направление
  форма обучения
  дата начала
  дата окончания
  стоимость обучения
}

entity "Вид договора\n<<внешний, справочник 1С>>" as Kind {
  * наименование
  --
  шаблон графика платежей
}

entity "Договор" as Contract {
  * номер
  --
  дата договора
  состояние
  состояние ЭП
  стоимость обучения
  дата начала
  дата окончания
}

entity "Дополнительное\nсоглашение" as Addendum {
  * номер
  --
  дата
  вид изменения
  основание
  новая стоимость
  состояние
  состояние ЭП
}

entity "Строка графика\nплатежей" as Schedule {
  * срок оплаты
  --
  процент
  сумма
  комментарий
}

entity "Электронный документ" as Doc {
  * имя файла
  --
  формат PDF/A
  хэш
  дата формирования
  файл со штампами ЭП
}

entity "Заявление ЕПГУ" as Order {
  * orderId
  --
  дата отправки
  срок подписания
  статус
  комментарий ЕПГУ
}

entity "Электронная подпись" as Signature {
  * номер сертификата и сторона
  --
  владелец
  дата подписи
  файл .sig
}

entity "Запись журнала\nобмена" as Log {
  * номер записи
  --
  время
  событие
  код ошибки
  маскированные данные
}

entity "Задача оператору" as Task {
  * номер задачи
  --
  причина
  срок
  статус
}

Student ||--o{ Contract : заключает
Payer ||--o{ Contract : оплачивает
Plan ||--o{ Contract : определяет
Kind ||--o{ Contract : типизирует
Contract ||--o{ Addendum : имеет
Contract ||--|{ Schedule : содержит
Addendum ||--o{ Schedule : содержит
Contract ||--o| Doc : оформляется
Addendum ||--o| Doc : оформляется
Doc ||--o| Order : направляется
Doc ||--o{ Signature : подписывается
Doc ||--o{ Log : фиксируется
Order ||--o{ Task : порождает

note bottom of Student
  Справочник физлиц уже есть в 1С.
  Подсистема читает ФИО, паспорт
  и СНИЛС, но не заводит вторую
  карточку человека.
end note

note bottom of Signature
  У успешно подписанного документа
  не более двух подписей: вуз
  и студент или плательщик.
end note

note bottom of Task
  Не более одной открытой задачи
  на одно заявление. Повторный
  REJECTED не создаёт дубль.
end note

@enduml
